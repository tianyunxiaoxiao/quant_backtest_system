[Unit]
Description=Build and atomically publish shared QPF/QBT daily and 5-minute data
After=docker.service network-online.target qpf-worker.service
Wants=network-online.target
Requires=docker.service
OnSuccess=qpf-factor-values-refresh.service
StartLimitIntervalSec=3h
StartLimitBurst=4

[Service]
Type=oneshot
EnvironmentFile=/etc/qpf/rqdata.env
EnvironmentFile=-/etc/qbt/data-update.env
ExecStart=/opt/qpf/venv/bin/python /opt/qbt/app/ops/data_update/daily_update.py
Restart=on-failure
RestartSec=15min
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
