# 原 qbt 项目根目录（默认与 quant_backtest_web 同目录下的 quant_backtest_system_clean）
# QBT_PROJECT_ROOT=/path/to/quant_backtest_system_clean

# 数据仓库目录（默认使用原项目的 warehouse）
# QBT_WAREHOUSE=/path/to/quant_backtest_system_clean/warehouse

# 指数成分来源目录（默认使用原项目的 data/index_membership_source）
# QBT_INDEX_DIR=/path/to/quant_backtest_system_clean/data/index_membership_source

# 产物输出目录（默认 quant_backtest_web/data/runs）
# OUTPUT_ROOT=/path/to/quant_backtest_web/data/runs

# SQLite 数据库路径（默认 quant_backtest_web/qbt_web.db）
# DATABASE_PATH=/path/to/quant_backtest_web/qbt_web.db

# CORS 允许来源
CORS_ORIGINS=["*"]
