# qbt 项目根目录（默认自动使用当前仓库根目录）
# QBT_PROJECT_ROOT=/path/to/quant_backtest_system

# 数据仓库目录（默认使用 QBT_PROJECT_ROOT/warehouse_rqdata）
# QBT_WAREHOUSE=/path/to/quant_backtest_system/warehouse_rqdata

# 指数成分来源目录（默认使用原项目的 data/index_membership_source）
# QBT_INDEX_DIR=/path/to/quant_backtest_system/data/index_membership_source

# 产物输出目录（默认 web_ui/data/runs）
# OUTPUT_ROOT=/path/to/quant_backtest_system/web_ui/data/runs

# SQLite 数据库路径（默认 web_ui/qbt_web.db）
# DATABASE_PATH=/path/to/quant_backtest_system/web_ui/qbt_web.db

# CORS 允许来源
CORS_ORIGINS=["*"]

# 共用因子研究平台账号、角色和会话；生产环境必须启用安全 Cookie。
QBT_AUTH_REQUIRED=true
QBT_SECURE_COOKIES=false
FACTOR_PLATFORM_URL=http://127.0.0.1:8765
FACTOR_TASK_API_URL=http://127.0.0.1:8780
FACTOR_TASK_API_KEY_ID=backtest-local
FACTOR_TASK_API_SECRET=replace-with-local-dev-secret
QBT_MAX_CONCURRENT_RUNS=1
