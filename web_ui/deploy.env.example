QBT_WAREHOUSE=/data/warehouse
QBT_INDEX_DIR=/data/index_membership_source
OUTPUT_ROOT=/data/runs
DATABASE_PATH=/data/qbt_web.db
CORS_ORIGINS=["https://quant.example.com"]
QBT_AUTH_REQUIRED=true
