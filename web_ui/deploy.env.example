# Same-domain research control plane and HMAC-authenticated internal task API.
FACTOR_PLATFORM_URL=https://quant-factor-research.onrender.com
FACTOR_TASK_API_URL=http://127.0.0.1:8780
FACTOR_TASK_API_KEY_ID=backtest-prod
FACTOR_TASK_API_SECRET=replace-with-aliyun-secret-manager-value
